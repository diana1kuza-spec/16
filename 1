# Считываем строку слов
text = input("Введите строку слов: ")

# Преобразуем строку в список слов, затем в множество для удаления дубликатов
unique_words = set(text.split())

# Выводим количество уникальных слов
print(f"Количество: {len(unique_words)}")

# Выводим слова в алфавитном порядке
# sorted() возвращает отсортированный список, который выводим через пробел
print("Слова:", " ".join(sorted(unique_words)))
